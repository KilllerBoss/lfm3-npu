<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/info_title"
            android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_engine"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_system_prompt"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_system"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minLines="3" android:maxLines="6"
            android:inputType="textMultiLine"
            android:background="@drawable/bg_input"
            android:padding="12dp" android:layout_marginTop="6dp"
            android:textColor="@color/text_primary" />

        <Switch
            android:id="@+id/sw_think"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_think"
            android:textColor="@color/text_primary"
            android:layout_marginTop="12dp" />

        <Switch
            android:id="@+id/sw_npu_fallback"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_npu_fallback"
            android:textColor="@color/text_primary"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/lbl_ctx"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/sb_ctx"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="7" />

        <TextView
            android:id="@+id/lbl_temp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/sb_temp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/info_links"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_links"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColorLink="@color/accent2"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:autoLink="web" />
    </LinearLayout>
</ScrollView>
